# Ignore Python source files in src/ (not API)
src/*.py
tests/
scripts/
data/
*.pcap
.venv/
__pycache__/
*.pyc
requirements.txt
Dockerfile
docker-compose.yml
.pytest_cache/

# Ignore development files
.env
.env.local
.env.development
.env.test
.env.production
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build artifacts (but not API endpoints)
dist/
build/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db
