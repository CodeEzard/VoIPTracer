{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/demo.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/upload-pcap.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api",
      "dest": "/api/index"
    },
    {
      "src": "/api/demo",
      "dest": "/api/demo"
    },
    {
      "src": "/api/upload-pcap",
      "dest": "/api/upload-pcap"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/$1"
    }
  ]
}
